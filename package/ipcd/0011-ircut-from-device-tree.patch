+/* Filter pins and polarity differ between boards, the device tree has them. */
+static int dt_ircut_read(const char *name, char *buf, size_t len)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/device-tree/ircut/%s", name);
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) return -1;
+    ssize_t n = read(fd, buf, len - 1);
+    close(fd);
+    if (n <= 0) return -1;
+    buf[n] = 0;
+    return 0;
+}
+
+static const char *dt_ircut_probe(const char *name, char *path, size_t len)
+{
+    char num[8];
+    if (dt_ircut_read(name, num, sizeof(num)) != 0) return NULL;
+    snprintf(path, len, "/sys/class/gpio/gpio%s/value", num);
+    const char *cand[] = { path, NULL };
+    return probe_ircut(cand);
+}
